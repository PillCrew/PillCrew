{
  "name": "pilly-desktop",
  "productName": "Pilly",
  "version": "1.1.5",
  "description": "Pilly - a tiny green pill AI friend that lives in your taskbar or menu bar. Free AI chat, live Solana coin checks, meme brain, watchlist & alerts.",
  "main": "main.js",
  "private": true,
  "author": "PillCrew",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://pillcrew.fun",
  "repository": {
    "type": "git",
    "url": "https://github.com/PillCrew/PillCrew"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/gen-icon.js",
    "postinstall": "node scripts/gen-icon.js",
    "test": "node --test src/*.test.js",
    "verify:anim": "electron scripts/verify-anim.js",
    "verify:boot": "electron scripts/verify-boot.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac --universal",
    "dist:linux": "electron-builder --linux",
    "dist:publish": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "//": "overrides.js-yaml: reached at runtime through electron-updater (it parses latest.yml), so the copy inside app.asar is what matters - 4.3.1 is the last vulnerable release, 4.3.2 fixes the maxTotalMergeKeys CPU exhaustion (GHSA-2883-xcg3-v3hh). Both consumers ask for ^4.1.0, so the pin stays inside the same major.",
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "build": {
    "appId": "fun.pillcrew.pilly",
    "productName": "Pilly",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "!src/*.test.js",
      "renderer/**",
      "assets/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "PillCrew",
        "repo": "PillCrew"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/pilly.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "assets/pilly-1024.png",
      "artifactName": "${productName}-${version}-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSApplicationCategoryType": "public.app-category.finance",
        "NSHighResolutionCapable": true,
        "LSMinimumSystemVersion": "10.15"
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/pilly-512.png",
      "maintainer": "PillCrew <contact@pillcrew.fun>",
      "synopsis": "A tiny green pill AI friend",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "scripts/deb-after-install.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pilly",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
