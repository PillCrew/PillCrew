{
  "name": "pilly-desktop",
  "productName": "Pilly",
  "version": "1.1.1",
  "description": "Pilly - a tiny green pill AI friend that lives in your taskbar or menu bar. Free AI chat, live Solana coin checks, meme brain, watchlist & alerts.",
  "main": "main.js",
  "private": true,
  "author": "PillCrew",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://pillcrew.fun",
  "repository": {
    "type": "git",
    "url": "https://github.com/PillCrew/PillCrew"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/gen-icon.js",
    "postinstall": "node scripts/gen-icon.js",
    "test": "node --test src/*.test.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac --universal",
    "dist:linux": "electron-builder --linux",
    "dist:publish": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fun.pillcrew.pilly",
    "productName": "Pilly",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "!src/*.test.js",
      "renderer/**",
      "assets/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "PillCrew",
        "repo": "PillCrew"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/pilly.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "assets/pilly-1024.png",
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/pilly-512.png",
      "maintainer": "PillCrew <contact@pillcrew.fun>",
      "synopsis": "A tiny green pill AI friend",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pilly",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
