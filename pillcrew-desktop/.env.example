# Pilly desktop app - local config
# Copy to .env and fill in what you have. At least ONE tier is needed.
# Tiers are tried in order (1 = cheapest/free first) until one answers.

# ---- Option B (recommended): direct provider chain (generic OpenAI-compatible) ----
# Put any chat-completions endpoint into PILLY_TIER1_URL, its key into
# PILLY_TIER1_KEY, and its model into PILLY_TIER1_MODEL (most providers require one).
# Add more tiers as fallbacks (tried in order). Set AUTH=none for keyless free endpoints.
PILLY_TIER1_URL=
PILLY_TIER1_KEY=
PILLY_TIER1_MODEL=
PILLY_TIER1_AUTH=bearer

PILLY_TIER2_URL=
PILLY_TIER2_KEY=
PILLY_TIER2_MODEL=
PILLY_TIER2_AUTH=bearer

PILLY_TIER3_URL=
PILLY_TIER3_KEY=
PILLY_TIER3_MODEL=
PILLY_TIER3_AUTH=bearer

PILLY_TIER4_URL=
PILLY_TIER4_KEY=
PILLY_TIER4_MODEL=
PILLY_TIER4_AUTH=bearer

PILLY_TIER5_URL=
PILLY_TIER5_KEY=
PILLY_TIER5_MODEL=
PILLY_TIER5_AUTH=bearer

# Tuning
PILLY_TEMPERATURE=0.8
PILLY_MAX_TOKENS=220
